# Production canonical URL (no trailing slash)
# Vercel: Project → Settings → Environment Variables → Production
NEXT_PUBLIC_SITE_URL=https://snu-portfoilo-last.vercel.app

# Formspree form ID (optional — enables contact form in Contact section)
# Create at https://formspree.io — free tier 50 submissions/month
# NEXT_PUBLIC_FORMSPREE_FORM_ID=

# @vercel/analytics: no env var required.
# Enable Web Analytics in Vercel → Project → Analytics → Enable.
